{
  "name": "ms-madrigral-spanish-500",
  "version": "1.0.0",
  "private": true,
  "description": "Ms. Madrigral Spanish 500 — retro 8-bit Spanish vocabulary trainer",
  "scripts": {
    "build:ios-web": "python3 tools/build_mobile_bundle.py",
    "ios:bootstrap": "bash tools/ios_store.sh bootstrap",
    "ios:setup": "bash tools/ios_store.sh setup",
    "ios:check": "bash tools/ios_store.sh check",
    "ios:open": "bash tools/ios_store.sh open",
    "ios:archive": "bash tools/ios_store.sh archive",
    "ios:clean": "bash tools/ios_store.sh clean",
    "ios:add": "npm run ios:setup",
    "ios:sync": "npm run ios:setup"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "typescript": "^5.9.2"
  }
}
